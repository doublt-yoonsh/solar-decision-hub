# Solar Decision Hub — environment variables
# 모두 비워두면 mock 모드로 동작합니다.
# Vercel 배포 시 동일한 키들을 Project Settings → Environment Variables에 입력하세요.

# ── 사이트 URL (필수, Vercel 배포 후 본인 도메인) ─────────────────
NEXT_PUBLIC_SITE_URL=https://solar-decision-hub.vercel.app

# ── 카카오 Local API (서버 전용 — 절대 NEXT_PUBLIC_ 금지) ─────────
# 발급: https://developers.kakao.com → 내 애플리케이션 → REST API 키
# 카카오 콘솔 → 앱 설정 → 플랫폼 → Web 사이트 도메인에 배포 도메인 등록 권장.
KAKAO_REST_API_KEY=

# ── 카카오 JavaScript SDK (지도 표시 — 현재 미사용, Phase 2B) ────
# JS SDK 사용 시 도메인 등록 필수.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── VWorld API (서버 전용 — 토지 종류 자동 추출) ────────────────
# 발급: https://www.vworld.kr/dev/v4dv_apiweb_s001.do
# 활용 API: 지오코더 API + 검색 API (기본). 데이터 API는 추가 신청 필요.
# 서비스URL에 배포 도메인 등록.
VWORLD_API_KEY=

# ── PVGIS 실제 호출 토글 ────────────────────────────────────────
# true 이면 EU JRC 엔드포인트 호출. 키 불필요. 비-true면 위도 기반 mock.
ENABLE_PVGIS_REAL=true
