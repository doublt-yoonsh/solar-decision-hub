# Solar Decision Hub — environment variables
# 모두 비워두면 mock 모드로 동작합니다. 키를 채우면 즉시 실제 모드로 전환.
#
# Vercel 배포 시 동일한 키들을 Project Settings → Environment Variables에 입력하세요.

# ── 사이트 URL (필수, Vercel 배포 후 본인 도메인으로 갱신) ────────
# metadata.openGraph, robots, sitemap에서 사용. 비우면 default 값 사용.
NEXT_PUBLIC_SITE_URL=https://solar-decision-hub.vercel.app

# ── 카카오 지도 / 로컬 API (선택, Phase 2B 활성화) ──────────────────
# 발급: https://developers.kakao.com → 애플리케이션 → 플랫폼 → Web 도메인 등록 필수
# JS 키: 브라우저 SDK 로드용 (NEXT_PUBLIC_*)
# REST 키: 서버사이드 호출용 (절대 NEXT_PUBLIC_ prefix 안 됨)
NEXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_REST_API_KEY=

# ── PVGIS 실제 호출 토글 (선택) ────────────────────────────────────
# true 이면 EU JRC 엔드포인트 호출. 기본 false (mock + regionDefaults 폴백).
ENABLE_PVGIS_REAL=false

# ── v2 후보 (영구 제외) ────────────────────────────────────────────
# v1에서는 /lib/location/siteTypeHeuristic.ts 휴리스틱 사용.
# VWORLD_API_KEY=
